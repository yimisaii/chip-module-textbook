<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="project_projx.xsd">
  <SchemaVersion>2.1</SchemaVersion>
  <Header>### uVision Project, (C) Keil Software</Header>
  <Targets>
    <Target>
      <TargetName>GPIO_EXTI</TargetName>
      <ToolsetNumber>0x4</ToolsetNumber>
      <ToolsetName>ARM-ADS</ToolsetName>
      <uAC6>1</uAC6>
      <TargetOption>
        <TargetCommonOption>
          <Device>STM32U575ZITxQ</Device>
          <Vendor>STMicroelectronics</Vendor>
          <PackID>Keil.STM32U5xx_DFP.3.2.0</PackID>
          <PackURL>https://www.keil.com/pack/</PackURL>
          <Cpu>IRAM(0x20000000,0x00030000) IROM(0x08000000,0x00200000) CPUTYPE("Cortex-M33") FPU3(SFPU) CLOCK(4000000) ELITTLE</Cpu>
          <OutputDirectory>.\Objects\</OutputDirectory>
          <OutputName>GPIO_EXTI</OutputName>
          <CreateExecutable>1</CreateExecutable>
          <CreateHexFile>1</CreateHexFile>
          <DebugInformation>1</DebugInformation>
          <BrowseInformation>1</BrowseInformation>
          <ListingPath>.\Listings\</ListingPath>
        </TargetCommonOption>
        <TargetArmAds>
          <ArmAdsMisc>
            <GenerateListings>0</GenerateListings>
            <AdsLmap>1</AdsLmap>
            <AdsLxrf>1</AdsLxrf>
            <AdsLszi>1</AdsLszi>
            <AdsLsxf>1</AdsLsxf>
            <AdsLsym>1</AdsLsym>
            <AdsLven>1</AdsLven>
            <AdsCpuType>"Cortex-M33"</AdsCpuType>
            <useUlib>0</useUlib>
            <RvctDeviceName>STM32U575ZITxQ</RvctDeviceName>
            <hadIROM>1</hadIROM>
            <hadIRAM>1</hadIRAM>
          </ArmAdsMisc>
          <Cads>
            <Optim>1</Optim>
            <wLevel>2</wLevel>
            <uC99>1</uC99>
            <VariousControls>
              <MiscControls>-std=c99</MiscControls>
              <Define>USE_HAL_DRIVER,STM32U575xx</Define>
              <IncludePath>..\Core;..\Drivers\STM32U5xx_HAL_Driver\Inc;..\Drivers\CMSIS\Include;..\Drivers\CMSIS\Device\ST\STM32U5xx\Include</IncludePath>
            </VariousControls>
          </Cads>
          <Aads>
            <uClangAs>0</uClangAs>
          </Aads>
          <LDads>
            <umfTarg>0</umfTarg>
            <TextAddressRange>0x08000000</TextAddressRange>
            <DataAddressRange>0x20000000</DataAddressRange>
            <ScatterFile>.\GPIO_EXTI.sct</ScatterFile>
          </LDads>
        </TargetArmAds>
      </TargetOption>
      <Groups>
        <Group>
          <GroupName>Application</GroupName>
          <Files>
            <File><FileName>main.c</FileName><FileType>1</FileType><FilePath>..\Core\main.c</FilePath></File>
            <File><FileName>button.c</FileName><FileType>1</FileType><FilePath>..\Core\button.c</FilePath></File>
          </Files>
        </Group>
        <Group>
          <GroupName>CMSIS Startup</GroupName>
          <Files>
            <File><FileName>startup_stm32u575xx.s</FileName><FileType>2</FileType><FilePath>..\Drivers\CMSIS\Device\ST\STM32U5xx\Source\Templates\arm\startup_stm32u575xx.s</FilePath></File>
            <File><FileName>system_stm32u5xx.c</FileName><FileType>1</FileType><FilePath>..\Drivers\CMSIS\Device\ST\STM32U5xx\Source\Templates\system_stm32u5xx.c</FilePath></File>
          </Files>
        </Group>
        <Group>
          <GroupName>STM32U5 HAL1</GroupName>
          <Files>
            <File><FileName>stm32u5xx_hal.c</FileName><FileType>1</FileType><FilePath>..\Drivers\STM32U5xx_HAL_Driver\Src\stm32u5xx_hal.c</FilePath></File>
            <File><FileName>stm32u5xx_hal_cortex.c</FileName><FileType>1</FileType><FilePath>..\Drivers\STM32U5xx_HAL_Driver\Src\stm32u5xx_hal_cortex.c</FilePath></File>
            <File><FileName>stm32u5xx_hal_gpio.c</FileName><FileType>1</FileType><FilePath>..\Drivers\STM32U5xx_HAL_Driver\Src\stm32u5xx_hal_gpio.c</FilePath></File>
            <File><FileName>stm32u5xx_hal_rcc.c</FileName><FileType>1</FileType><FilePath>..\Drivers\STM32U5xx_HAL_Driver\Src\stm32u5xx_hal_rcc.c</FilePath></File>
            <File><FileName>stm32u5xx_hal_pwr.c</FileName><FileType>1</FileType><FilePath>..\Drivers\STM32U5xx_HAL_Driver\Src\stm32u5xx_hal_pwr.c</FilePath></File>
            <File><FileName>stm32u5xx_hal_pwr_ex.c</FileName><FileType>1</FileType><FilePath>..\Drivers\STM32U5xx_HAL_Driver\Src\stm32u5xx_hal_pwr_ex.c</FilePath></File>
          </Files>
        </Group>
      </Groups>
    </Target>
  </Targets>
</Project>
